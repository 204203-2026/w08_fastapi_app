# Copy to .env if you want to override defaults (optional — docker-compose.yml
# already falls back to the real Open-Meteo host when this is unset).
#
# AQI_BASE_URL is the upstream host /api/aqi calls. Leave it unset (or point
# it at the real host below) for normal development. check.sh and CI set it
# to the aqi-fixture compose service instead, so grading needs no network.
AQI_BASE_URL=https://air-quality-api.open-meteo.com
